# ===== Conexão com o servidor =====
# URL do servidor (wss:// se estiver atrás de HTTPS, ex: Cloudflare Tunnel)
JARVIS_SERVER=ws://localhost:8787/ws
JARVIS_TOKEN=troque-por-uma-senha-longa

# ===== Groq (ultra rápido: conversa, roteamento e monitoramento da tela) =====
GROQ_API_KEY=gsk_...
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SMART_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ===== Claude (tarefas complexas no PC) =====
# cli  = usa o Claude Code instalado no PC com sua ASSINATURA (claude login)
# api  = usa a API da Anthropic com "computer use" (precisa ANTHROPIC_API_KEY)
CLAUDE_BACKEND=cli
CLAUDE_CLI=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_STEPS=60

# ===== Monitoramento automático =====
MONITOR_ENABLED=1
# a cada quantos segundos olhar a tela
MONITOR_INTERVAL=20
# força uma análise mesmo sem mudança na tela (segundos)
MONITOR_FORCE_EVERY=300
# não repetir o mesmo alerta antes de (segundos)
ALERT_COOLDOWN=900
# urgência mínima para LIGAR (abaixo disso vira só notificação): baixa | normal | alta | critica
CALL_MIN_URGENCY=normal
# regras suas, em texto livre (o que deve gerar ligação)
WATCH_RULES=Me ligue se aparecer erro, travamento, download/render/build terminado, mensagem importante no WhatsApp/Discord/e-mail, aviso de segurança, bateria baixa, ou se algum programa pedir minha confirmação.

# ===== Tela ao vivo no app =====
STREAM_FPS=1.5
STREAM_WIDTH=1100
