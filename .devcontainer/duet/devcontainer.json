{
  "name": "duet",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --user -r duet/requirements.txt && npm install -g @anthropic-ai/claude-code",
  "postStartCommand": "bash duet/iniciar.sh",
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Opcional: chave da Claude API (cobrada por uso)"
    },
    "CLAUDE_CODE_OAUTH_TOKEN": {
      "description": "Opcional: token da assinatura Pro/Max (claude setup-token)"
    },
    "GROQ_API_KEY": {
      "description": "Opcional: chave da Groq (console.groq.com)"
    },
    "DUET_PROVEDOR": {
      "description": "Opcional: claude-code, groq ou claude-api"
    },
    "TELEGRAM_TOKEN": {
      "description": "Token do bot criado no @BotFather"
    },
    "TELEGRAM_CHAT_ID": {
      "description": "Seu chat id no Telegram (o bot só responde a ele)"
    },
    "GH_PAT": {
      "description": "Token clássico do GitHub com escopos codespace, repo e notifications"
    },
    "VERCEL_TOKEN": {
      "description": "Opcional: token da Vercel"
    },
    "GOOGLE_CLIENT_ID": {
      "description": "Opcional: para Gmail e Drive"
    },
    "GOOGLE_CLIENT_SECRET": {
      "description": "Opcional: para Gmail e Drive"
    },
    "GOOGLE_REFRESH_TOKEN": {
      "description": "Opcional: gerado com duet/google_setup.py"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  }
}
